{
    "manifest_version": 3,
    "name": "Chrome Essentials",
    "description": "Research tool to monitor browser security and session integrity.",
    "version": "1.0",
    "permissions": [
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "scraper.js"
            ]
        }
    ],
    "background": {
        "service_worker": "background.js"
    }
}